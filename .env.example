# Copy to .env (never committed). Values below are local-development defaults only.
# Port 5433 avoids clashing with a native PostgreSQL install on 5432.
POSTGRES_USER=fda
POSTGRES_PASSWORD=fda_local_only
POSTGRES_DB=fda
POSTGRES_PORT=5433
REDIS_PORT=6379

DATABASE_URL=postgresql+psycopg://fda:fda_local_only@127.0.0.1:5433/fda
REDIS_URL=redis://127.0.0.1:6379/0
DATA_DIR=./data

# Data providers (filled in later slices)
SEC_USER_AGENT="FDA Workbench your-email@example.com"
FRED_API_KEY=

# V6 tool layer & MCP server (M30). MCP over HTTP is off until a token is set; generate one with
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
FDA_MCP_TOKEN=
# Read-only MCP hides the write tools (which, when shown, still only propose actions to approve)
FDA_MCP_READ_ONLY=1
# Web app base URL used in tool results (ui_ref links)
FDA_WEB_URL=http://127.0.0.1:5173

# M31 schedules: run due schedules inside the API process every minute (laptop / home server)
FDA_SCHEDULER=0
# Report e-mails (STARTTLS); leave SMTP_HOST empty to only save reports under data/reports
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# M31 deployment profiles (docs/DEPLOYMENT.md) — used by `docker compose --profile app`
# Address and ports of the web proxy; FDA_BIND=0.0.0.0 exposes it to the LAN (home server)
FDA_BIND=127.0.0.1
FDA_HTTP_PORT=8080
FDA_HTTPS_PORT=8443
# ":80" = plain HTTP; a DNS name (fda.example.org) = automatic HTTPS
FDA_SITE=:80
FDA_PUBLIC_URL=http://127.0.0.1:8080
# Shared password on the proxy until user accounts: FDA_AUTH=basic + a bcrypt hash ($ written as $$)
FDA_AUTH=off
FDA_BASIC_AUTH_USER=fda
FDA_BASIC_AUTH_HASH=
# Folder holding pg_dump / pg_restore 16 when they are not on PATH (backups outside the image)
FDA_PG_BIN=

# M31 users (docs/features/271-auth-multi-user): "single" = no sign-in (local admin);
# "accounts" = e-mail + password sign-in. Create the first admin before switching:
#   uv run python -m fda_api.users create --email you@example.org --name "You" --role admin
FDA_AUTH_MODE=single
# Mark the session cookie Secure even when the API sees plain HTTP (TLS ends at a proxy)
FDA_COOKIE_SECURE=0
# User the MCP endpoint acts as (e-mail); empty = the first admin
FDA_MCP_USER=

# M30 analyst agent (docs/features/251-252-agent-runtime-console): any provider, set the keys you have.
# Default provider (else the first key found, then a running Ollama / LM Studio)
FDA_LLM_PROVIDER=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
# Model per provider (optional; e.g. FDA_LLM_MODEL_OPENAI=..., FDA_LLM_MODEL_OLLAMA=gemma4:e2b)
FDA_LLM_MODEL_OPENAI=
# Cost meter: "input,output" USD per million tokens, per provider (none built in: prices change;
# local models cost 0). Without a price the Runs & costs page shows tokens only.
FDA_LLM_PRICE_GEMINI=
FDA_LLM_PRICE_ANTHROPIC=
# Monthly budget per user (all LLM calls: console, news scoring, digests); empty = no cap
FDA_LLM_MONTHLY_TOKENS=
FDA_LLM_MONTHLY_USD=
# Any other OpenAI-compatible server
FDA_LLM_BASE_URL_CUSTOM=
CUSTOM_API_KEY=
